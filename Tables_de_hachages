    const n = labels.length, S = 2, gw = (W - L - R) / n, bw = gw * 0.8 / S;
    const Y = v => H - B - v / mx * (H - B - T);
    let s = '';
    for (let i = 0; i <= 4; i++) { const v = mx * i / 4; const y = Y(v); s += '<line x1="' + L + '" y1="' + y + '" x2="' + (W - R) + '" y2="' + y + '" stroke="#e8e8ee"/><text x="' + (L - 5) + '" y="' + (y + 3.5) + '" text-anchor="end" font-size="10.5" fill="#6a6a78">' + fmtN(Math.round(v)) + '</text>'; }
    s += '<line x1="' + L + '" y1="' + (H - B) + '" x2="' + (W - R) + '" y2="' + (H - B) + '" stroke="#55555f"/>';
    [mes, po].forEach((vals, j) => vals.forEach((v, i) => { const x = L + i * gw + gw * 0.1 + j * bw, hh = (H - B - T) * v / mx; if (v > 0) s += '<rect x="' + x.toFixed(1) + '" y="' + (H - B - hh).toFixed(1) + '" width="' + Math.max(1, bw - 1).toFixed(1) + '" height="' + hh.toFixed(1) + '" fill="' + (j === 0 ? '#6557d2' : '#e08a00') + '"/>'; }));
    labels.forEach((l, i) => { if (i % 1 === 0) s += '<text x="' + (L + i * gw + gw / 2).toFixed(1) + '" y="' + (H - B + 13) + '" text-anchor="middle" font-size="10.5" fill="#6a6a78">' + l + '</text>'; });
    s += '<text x="' + ((L + W - R) / 2) + '" y="' + (H - 4) + '" text-anchor="middle" font-size="11.5" fill="#1f1f28">k fiches dans un tiroir</text>';
    ['mesuré', 'Poisson'].forEach((name, j) => { const x = W - R - 150, y = T + 8 + j * 15; s += '<rect x="' + x + '" y="' + (y - 7) + '" width="12" height="10" fill="' + (j === 0 ? '#6557d2' : '#e08a00') + '"/><text x="' + (x + 18) + '" y="' + (y + 2) + '" font-size="11" fill="#1f1f28">' + name + '</text>'; });
    svg.innerHTML = s;
