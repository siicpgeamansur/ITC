    '<div class="verdict" id="w1-msg" aria-live="polite"></div>' +
    '<h3>Mutable ou immuable ?</h3><p>Un objet est <b>mutable</b> si on peut changer sa valeur après sa création, sans nouvelle affectation.</p><div id="w1-types"></div><div id="w1-type-out"></div>';
  const S = W1;
  const draw = () => {
    const sc = SCENARIOS[S.scen], st = sc.steps[S.step], prev = S.step > 0 ? sc.steps[S.step - 1] : null;
    const sg = $('#w1-scen'); sg.innerHTML = ''; sg.append(chipsRow(Object.keys(SCENARIOS).map(k => [k, SCENARIOS[k].label]), S.scen, k => { S.scen = k; S.step = 0; draw(); }, 'Scénario'));
    $('#w1-code').innerHTML = codeBlock(sc.code, st.line);
    $('#w1-msg').innerHTML = '<b>Étape ' + (S.step + 1) + ' / ' + sc.steps.length + '.</b> ' + st.t;
    $('#w1-msg').className = 'verdict' + (S.step === sc.steps.length - 1 ? ' yes' : '');
    // dessin noms/objets
    const names = [];
    Object.entries(st.g).forEach(([n, o]) => names.push({ n, o, fr: 'global' }));
    if (st.f) Object.entries(st.f).forEach(([n, o]) => names.push({ n, o, fr: 'f' }));
    const ids = Object.keys(st.o);
    const addr = id => 17559536 + 32 * (parseInt(id.slice(1), 10) - 1);
    let html = '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start"><div><b class="small">NOMS (étiquettes)</b>';
    names.forEach(nm => {
      const f = nm.fr === 'f';
      html += '<div style="margin:6px 0;padding:6px 8px;border:1px solid ' + (f ? '#e08a00' : 'var(--line)') + ';background:' + (f ? '#fff3dc' : '#fff') + ';border-radius:6px;font-family:var(--font-mono);font-size:13px">' + esc(nm.n) + (f ? ' <span class="small">(local)</span>' : '') + '</div>';
    });
    html += '</div><div><b class="small">OBJETS (mémoire)</b>';
    ids.forEach(id => {
      const [t, v] = st.o[id], isNew = prev && !prev.o[id], mut = prev && prev.o[id] && prev.o[id][1] !== v;
      const refs = names.filter(n => n.o === id).length;
      html += '<div style="margin:6px 0;padding:6px 8px;border:1px solid ' + (isNew ? 'var(--ok)' : mut ? 'var(--warn)' : 'var(--line)') + ';background:' + (isNew ? 'rgba(30,122,46,.12)' : mut ? 'rgba(154,91,0,.12)' : '#fff') + ';border-radius:6px;font-family:var(--font-mono);font-size:13px">' + esc(v) + ' <span class="small">' + t + ' · id ' + addr(id) + ' · ' + refs + ' nom' + (refs > 1 ? 's' : '') + '</span></div>';
    });
    html += '</div></div>';
    $('#w1-stage').innerHTML = html;
    // tableau mutable/immuable
    const tw = $('#w1-types'); tw.innerHTML = '';
    tw.append(chipsRow(Object.keys(TYPES_MUT).map(t => [t, t]), S.type, t => { S.type = t; draw(); }, 'Type'));
    const T = TYPES_MUT[S.type];
    $('#w1-type-out').innerHTML = '<p>' + (T.m ? '<span class="verdict yes" style="display:inline-block;padding:2px 8px">mutable</span>' : '<span class="verdict no" style="display:inline-block;padding:2px 8px">immuable</span>') + '</p>' + codeBlock(T.ex) + '<p class="small">' + T.r + '</p>';
    $('#w1-prev').disabled = S.step === 0; $('#w1-next').disabled = S.step === sc.steps.length - 1;
  };
  $('#w1-prev').addEventListener('click', () => { if (S.step > 0) { S.step--; draw(); } });
  $('#w1-next').addEventListener('click', () => { if (S.step < SCENARIOS[S.scen].steps.length - 1) { S.step++; draw(); } });
  $('#w1-reset').addEventListener('click', () => { S.step = 0; draw(); });
  draw();
}
WORKSHOPS.push({ id: 'w1', title: LAB1.title, hint: LAB1.hint, mount: mountW1, leave: () => {}, reset: () => { Object.assign(W1, { scen: 'liste', step: 0, type: 'list' }); } });

/* ================= Atelier 2 : Dictionnaire ================= */
const W2 = { preset: 'mdp', map: new Map(), pre: 'mdp', last: null, con: [], key: '"M. Catry"', val: '"j\'adore les maths"' };
function mountW2(root) {
  root.innerHTML = '<h2>Le dictionnaire</h2><p>Un dictionnaire associe à chaque <b>clé</b> une <b>valeur</b>. Opérations : ajouter, supprimer une association, obtenir la valeur d\'une clé.</p>' +
    '<div class="opts"><div class="fld"><span>Exemple</span><div id="w2-pre"></div></div></div>' +
    '<div class="fld"><span>Contenu (une association par ligne : clé : valeur)</span><textarea id="w2-text" rows="5" class="mono" spellcheck="false"></textarea></div>' +
    '<div class="opts"><label class="fld"><span>Clé k</span><input type="text" id="w2-k" class="mono" autocomplete="off"></label><label class="fld"><span>Valeur v</span><input type="text" id="w2-v" class="mono" autocomplete="off"></label></div>' +
    '<div class="files" id="w2-ops" style="margin:6px 0"></div>' +
