    '<h3>Console</h3><pre class="code" id="w2-con" style="min-height:90px"></pre><div class="files"><button class="btn sm" id="w2-clear" type="button">Effacer</button></div>' +
    '<h3>Complexité des opérations</h3><div class="dwrap"><table class="dt"><thead><tr><th>Python</th><th>Description</th><th>Complexité</th></tr></thead><tbody>' +
    '<tr><td><code>d[k] = v</code></td><td>Ajout (ou modification) d\'une association de k à v</td><td>O(1) en moyenne</td></tr>' +
    '<tr><td><code>d[k]</code></td><td>Accès à la valeur de clé k</td><td>O(1) en moyenne</td></tr>' +
    '<tr><td><code>len(d)</code></td><td>Nombre de clés de d</td><td>O(1) en moyenne</td></tr>' +
    '<tr><td><code>for k in d:</code></td><td>Parcourir les clés k de d</td><td>O(n), n = nombre de clés</td></tr></tbody></table></div>' +
    '<h3>Parcours et exercices</h3><div id="w2-extra"></div>';
  const S = W2;
  const parseDict = text => {
    const m = new Map(); let notes = [];
    for (const line of text.split('\n')) {
      const t = line.trim(); if (!t) continue;
      const mm = t.match(/^((?:"[^"]*"|'[^']*'|[^:])+?)\s*:\s*(.*)$/);
      if (!mm) continue;
      const ki = parseKey(mm[1]); if (!ki) continue;
      const u = unhashable(mm[1]);
      if (u) { notes.push('TypeError : unhashable type : \'' + u + '\' (clé ' + mm[1] + ')'); continue; }
      if (m.has(ki.id)) notes.push(ki.label + ' remplace une clé égale déjà présente');
      m.set(ki.id, { ki, v: mm[2].trim() });
    }
    return { m, notes };
  };
  const items = () => Array.from(S.map.values());
  const reprDict = () => '{' + items().map(e => pyRepr(e.ki) + ': ' + e.v).join(', ') + '}';
  const renderCon = () => {
    $('#w2-con').innerHTML = S.con.length ? S.con.map(c => '<span style="display:block;padding:0 8px;color:var(--muted)">&gt;&gt;&gt; ' + esc(c.cmd) + '</span><span style="display:block;padding:0 8px;color:' + (c.err ? 'var(--bad)' : 'var(--fg)') + '">' + esc(c.out) + '</span>').join('') : '<span style="padding:0 8px;color:var(--muted)">Choisis une opération.</span>';
  };
  const log = (cmd, out, err) => { S.con.push({ cmd, out, err }); if (S.con.length > 14) S.con.shift(); renderCon(); };
  const getK = () => parseKey($('#w2-k').value), getV = () => $('#w2-v').value.trim();
  const OPS = [['get', 'd[k]'], ['set', 'd[k] = v'], ['in', 'k in d'], ['notin', 'k not in d'], ['getd', 'd.get(k, 0)'], ['del', 'del d[k]'], ['len', 'len(d)'], ['keys', 'd.keys()'], ['values', 'd.values()'], ['items', 'd.items()']];
  $('#w2-ops').innerHTML = OPS.map(([id, l]) => '<button class="btn' + (id === 'set' ? ' pri' : '') + ' sm" type="button" data-op="' + id + '">' + esc(l) + '</button>').join('');
  function doOp(op) {
    const ki = getK(), need = !['len', 'keys', 'values', 'items'].includes(op);
    if (need && !ki) { log('…', 'Saisis une clé k.', true); return; }
    const key = ki ? (ki.type === 'str' ? '"' + ki.s + '"' : ki.label) : '';
    const e = ki ? S.map.get(ki.id) : null;
    S.last = ki && need ? ki.id : null;
    if (op === 'get') { e ? log('d[' + key + ']', e.v) : log('d[' + key + ']', 'KeyError: ' + pyRepr(ki), true); }
    else if (op === 'set') {
      const v = getV() || 'None';
      const u = unhashable(ki.label); if (u) log('d[' + key + '] = ' + v, 'TypeError: unhashable type: \'' + u + '\'', true);
      else { S.map.set(ki.id, { ki: e ? e.ki : ki, v }); log('d[' + key + '] = ' + v, e ? '(valeur modifiée)' : '(clé ajoutée)'); syncText(); }
    }
    else if (op === 'in') log(key + ' in d', e ? 'True' : 'False');
    else if (op === 'notin') log(key + ' not in d', e ? 'False' : 'True');
    else if (op === 'getd') log('d.get(' + key + ', 0)', e ? e.v : '0');
    else if (op === 'del') { if (e) { S.map.delete(ki.id); log('del d[' + key + ']', '(association supprimée)'); syncText(); } else log('del d[' + key + ']', 'KeyError: ' + pyRepr(ki), true); }
    else if (op === 'len') log('len(d)', String(S.map.size));
    else if (op === 'keys') log('list(d.keys())', '[' + items().map(e => pyRepr(e.ki)).join(', ') + ']');
    else if (op === 'values') log('list(d.values())', '[' + items().map(e => e.v).join(', ') + ']');
    else if (op === 'items') log('list(d.items())', '[' + items().map(e => '(' + pyRepr(e.ki) + ', ' + e.v + ')').join(', ') + ']');
    renderAll();
  }
  root.querySelectorAll('[data-op]').forEach(b => b.addEventListener('click', () => doOp(b.dataset.op)));
  $('#w2-clear').addEventListener('click', () => { S.con = []; renderCon(); });
  const syncText = () => { $('#w2-text').value = items().map(e => (e.ki.type === 'str' ? '"' + e.ki.s + '"' : e.ki.label) + ' : ' + e.v).join('\n'); };
  const sg = $('#w2-pre');
  sg.append(chipsRow(Object.keys(PRESETS).map(k => [k, PRESETS[k].name]), S.pre, k => { S.pre = k; $('#w2-text').value = PRESETS[k].text; fromText(); }, 'Exemple'));
  function fromText() { const r = parseDict($('#w2-text').value); S.map = r.m; S.last = null; renderAll(); }
  $('#w2-text').addEventListener('input', fromText);
  function renderAll() {
    const it = items();
    let html = '<div class="files" style="justify-content:space-between"><b class="small">len(d) = ' + it.length + '</b><span class="small">type(d) = dict</span></div>';
    html += it.length ? '<div class="grid2">' + it.map(e => '<div class="bucket' + (S.last === e.ki.id ? '' : ' empty') + '" style="background:' + (S.last === e.ki.id ? 'rgba(30,122,46,.1)' : '#fff') + '"><div class="bi"><span class="tag" style="font-size:10px;padding:0 4px;border-radius:3px;background:#e6effc;color:#1f3fa0">' + e.ki.type + '</span> ' + esc(pyRepr(e.ki)) + '</div><span class="pkt' + (S.last === e.ki.id ? ' hit' : '') + '">' + esc(e.v || 'None') + '</span></div>').join('') + '</div>' : '<p class="small">Dictionnaire vide : <code>{}</code></p>';
    html += '<p class="mono small">d = ' + esc(reprDict()) + '</p>';
    // exercices
    let ex = '';
    // inverse
    const inv = new Map(), dups = [], bad = [];
    it.forEach(e => { const u = unhashable(e.v); if (u) { bad.push(e.v + ' (type ' + u + ')'); return; } const ki = parseKey(e.v); if (!ki) return; if (inv.has(ki.id)) dups.push(e.v); inv.set(ki.id, { ki, v: pyRepr(e.ki) }); });
    ex += '<h4>Exercice : inverse(d)</h4><p class="small">On veut <code>d[k] == v ⇔ d2[v] == k</code>, en supposant que d ne contient pas deux fois la même valeur.</p>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="opts"><div>' + codeBlock('def inverse(d):\n    d2 = {}                 # nouveau dictionnaire\n    for k in d:             # O(n)\n        v = d[k]            # O(1)\n        d2[v] = k           # O(1)\n    return d2') + '<p class="small">Version élégante :</p>' + codeBlock('def inverse(d):\n    return {v: k for k, v in d.items()}') + '</div><div><b class="small">d2 = inverse(d)</b>' +
      (inv.size ? '<div class="dwrap"><table class="dt"><thead><tr><th>clé de d2 (= v)</th><th>valeur (= k)</th></tr></thead><tbody>' + Array.from(inv.values()).map(e => '<tr><td><code>' + esc(e.ki.label) + '</code></td><td><code>' + esc(e.v) + '</code></td></tr>').join('') + '</tbody></table></div>' : '<p class="small">Rien à afficher.</p>') +
      (dups.length ? '<p class="verdict warn"><b>Valeur en double :</b> ' + dups.map(esc).join(', ') + '. Une seule association est conservée, la dernière.</p>' : '') +
      (bad.length ? '<p class="verdict no"><b>TypeError : unhashable.</b> ' + bad.map(esc).join(', ') + ' ne peut pas servir de clé.</p>' : '') + '</div></div>';
    // frequent
    const L = S.L === undefined ? '3 1 3 2 1 3 4 1 3' : S.L;
    ex += '<h4>Exercice : frequent(L) en O(n)</h4><div class="fld"><span>L =</span><input type="text" id="w2-L" class="mono" value="' + esc(L) + '" autocomplete="off"></div><div id="w2-freq"></div>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px" class="opts"><div>' + codeBlock('def frequent(L):\n    if not L:\n        return None\n    occurrences = {}\n    for element in L:\n        occurrences[element] = occurrences.get(element, 0) + 1\n    return max(occurrences, key=occurrences.get)') + '</div><div>' + codeBlock('def frequent(L):\n    if not L:\n        return None\n    occurrences = {}\n    for element in L:\n        if element in occurrences:\n            occurrences[element] += 1\n        else:\n            occurrences[element] = 1\n    plus_frequent = L[0]\n    max_occ = 0\n    for element, compte in occurrences.items():\n        if compte > max_occ:\n            max_occ = compte\n            plus_frequent = element\n    return plus_frequent') + '</div></div>';
    $('#w2-vis').innerHTML = html;
    $('#w2-extra').innerHTML = ex;
    const inp = $('#w2-L');
    if (inp) {
      const upd = () => {
        S.L = inp.value;
        const L2 = inp.value.split(/[\s,;]+/).filter(Boolean).slice(0, 200);
        const oc = freqOf(L2), arr = Array.from(oc.entries());
        let best = null, bm = 0; arr.forEach(([k, c]) => { if (c > bm) { bm = c; best = k; } });
        $('#w2-freq').innerHTML = L2.length ? '<div class="dwrap"><table class="dt" style="margin-top:6px"><thead><tr><th>élément</th>' + arr.map(a => '<th><code>' + esc(a[0]) + '</code></th>').join('') + '</tr><tr><th>occurrences</th>' + arr.map(a => '<td class="m" style="' + (a[0] === best ? 'background:rgba(30,122,46,.12);font-weight:600' : '') + '">' + a[1] + '</td>').join('') + '</tr></thead></table></div><p class="verdict yes">frequent(L) = <b>' + esc(best) + '</b> (' + bm + ' fois). Un parcours de L : n = ' + L2.length + ' mises à jour du dictionnaire, chacune en O(1).</p>' : '<p class="verdict warn">frequent([]) renvoie None.</p>';
      };
      inp.addEventListener('input', upd); upd();
    }
  }
  $('#w2-text').value = PRESETS[S.pre].text; fromText(); renderCon();
  log('d["M. Chomette"]', "'artif'");
}
