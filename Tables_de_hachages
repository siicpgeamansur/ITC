  intro: 'En Python, un nom est une <b>étiquette</b> collée sur un objet. Appeler une fonction crée de nouvelles étiquettes sur les mêmes objets. Modifier un objet <b>mutable</b> (liste) se voit à l\'extérieur, mais réaffecter une variable ne modifie jamais l\'objet d\'origine.' };
function mountW1(root) {
  root.innerHTML = '<h2>' + LAB1.title + '</h2><p>' + LAB1.intro + '</p>' +
    '<div class="opts"><div class="fld"><span>Scénario</span><div id="w1-scen"></div></div></div>' +
    '<div class="files" style="margin:8px 0"><button class="btn" id="w1-prev" type="button">◀ Précédent</button><button class="btn pri" id="w1-next" type="button">Suivant ▶</button><button class="btn" id="w1-reset" type="button">Départ</button></div>' +
