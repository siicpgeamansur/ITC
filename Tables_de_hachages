/* ================= Atelier 3 : Applications ================= */
const W3 = { mode: 'pond', text: PRESETS.graphe_pond.text, u: '0', w: '2', x: '1' };
function mountW3(root) {
  root.innerHTML = '<h2>Applications du dictionnaire</h2><p>Un dictionnaire peut représenter un <b>espace de noms</b> (globals, locals) ou un <b>graphe</b> : <code>G[v]</code> donne les voisins du sommet v.</p>' +
    '<h3>globals et locals</h3><p>Python conserve en mémoire deux dictionnaires de variables : <code>globals()</code> et <code>locals()</code>.</p>' +
    codeBlock('a = 10\ndef f(x):\n    y = 2\n    print(locals())\nf(1)   # affiche {\'x\': 1, \'y\': 2}') +
    '<div class="opts"><label class="fld"><span>Argument de f</span><input type="text" id="w3-x" class="mono" style="width:80px"></label></div><p class="verdict" id="w3-loc"></p>' +
    '<h3>Représenter un graphe</h3><div class="opts"><div class="fld"><span>Graphe</span><div id="w3-pre"></div></div></div>' +
    '<div class="fld"><span>G = {sommet: [voisins] ou {voisin: poids}}</span><textarea id="w3-text" rows="7" class="mono" spellcheck="false"></textarea></div>' +
    '<div class="opts"><label class="fld"><span>u</span><input type="text" id="w3-u" class="mono" style="width:70px"></label><label class="fld"><span>v</span><input type="text" id="w3-w" class="mono" style="width:70px"></label></div>' +
    '<p class="verdict" id="w3-q"></p>' +
    '<div class="stagebox" id="w3-graph" style="border:1px solid var(--line);border-radius:10px;padding:10px;background:#fff"></div><p class="mono small" id="w3-repr"></p>';
  const S = W3;
  $('#w3-x').value = S.x;
  const updLoc = () => { const xv = $('#w3-x').value.trim() || 'None'; $('#w3-loc').innerHTML = '<b>locals()</b> dans f : <code>{\'x\': ' + esc(xv) + ', \'y\': 2}</code><br><b>globals()</b> : <code>{\'a\': 10, \'f\': &lt;function f&gt;, …}</code><br>Une variable locale n\'existe que dans le bloc de la fonction.'; };
  $('#w3-x').addEventListener('input', updLoc); updLoc();
  const sg = $('#w3-pre');
  sg.append(chipsRow([['simple', 'Graphe du cours'], ['pond', 'Graphe pondéré']], S.mode, k => { S.mode = k; $('#w3-text').value = PRESETS[k === 'pond' ? 'graphe_pond' : 'graphe'].text; render(); }, 'Graphe'));
  function render() {
    const r = parseGraph($('#w3-text').value);
    const nodes = Array.from(r.g.keys());
    for (const nb of r.g.values()) for (const k of nb.keys()) if (!r.g.has(k) && !nodes.includes(k)) nodes.push(k);
    // positions : cercle
    const pos = {};
    nodes.forEach((n, i) => { const ang = -Math.PI / 2 + i * 2 * Math.PI / Math.max(nodes.length, 1); pos[n] = [300 + 190 * Math.cos(ang), 215 + 150 * Math.sin(ang)]; });
    let s = '<svg viewBox="0 0 600 430" style="width:100%;max-width:640px;height:auto">';
    s += '<defs><marker id="w3ar" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"><path d="M0,0 L9,4.5 L0,9 z" fill="#55555f"/></marker></defs>';
    const edges = [];
    for (const [a, nb] of r.g) for (const [b, wt] of nb) edges.push([a, b, wt]);
    const has = (a, b) => r.g.has(a) && r.g.get(a).has(b);
    const drawn = new Set();
    edges.forEach(([a, b, wt]) => {
      if (!pos[a] || !pos[b]) return;
      const sym = has(b, a), key = sym ? [a, b].sort().join('|') : a + '>' + b;
      if (drawn.has(key)) return; drawn.add(key);
      const [x1, y1] = pos[a], [x2, y2] = pos[b];
      if (a === b) { s += '<path d="M' + x1 + ',' + (y1 - 18) + ' c-30,-50 30,-50 0,0" fill="none" stroke="#55555f" stroke-width="1.6" marker-end="url(#w3ar)"/>'; return; }
      const dx = x2 - x1, dy = y2 - y1, L = Math.hypot(dx, dy) || 1, ux = dx / L, uy = dy / L;
      const hl = a === S.u || (sym && b === S.u);
      const col = hl ? '#e08a00' : '#55555f';
      s += '<line x1="' + (x1 + ux * 20) + '" y1="' + (y1 + uy * 20) + '" x2="' + (x2 - ux * (sym ? 20 : 23)) + '" y2="' + (y2 - uy * (sym ? 20 : 23)) + '" stroke="' + col + '" stroke-width="' + (hl ? 3 : 1.8) + '"' + (sym ? '' : ' marker-end="url(#w3ar)"') + '/>';
      if (wt !== null) s += '<text x="' + ((x1 + x2) / 2 - uy * 12) + '" y="' + ((y1 + y2) / 2 + ux * 12 + 4) + '" text-anchor="middle" font-size="14" font-weight="600" fill="#1565c0" paint-order="stroke" stroke="#fff" stroke-width="4">' + fmt(wt, 2) + '</text>';
    });
